# Bu dosyayı .env.local olarak kopyalayıp doldurun. .env.local git'e girmez.
#
# TURN olmadan da çoğu görüşme çalışır (doğrudan bağlantı). TURN yalnızca
# simetrik NAT veya sıkı güvenlik duvarı arkasındaki kullanıcılar için gerekir.

# Virgülle ayrılmış TURN adresleri. Boş bırakılırsa TURN kullanılmaz.
#
# Metered (ayda 20 GB ücretsiz, kayıt gerekir):
#   VITE_TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443
#
# Yerel coturn (docker compose --profile turn up -d):
#   VITE_TURN_URLS=turn:192.168.1.101:3478      ← makinenizin LAN IP'si
VITE_TURN_URLS=

VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Doldurduktan sonra doğrulayın:  node turn-test.mjs

# STUN adresleri (opsiyonel). Boş bırakılırsa Google'ın public STUN sunucuları kullanılır.
VITE_STUN_URLS=

# 'relay' yapılırsa doğrudan bağlantı hiç denenmez; TURN'ün gerçekten
# çalıştığını doğrulamak için kullanılır. Üretimde boş bırakın.
VITE_ICE_TRANSPORT_POLICY=
